# Google AI Studio Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_ALT=
GEMINI_MODEL=gemini-3.5-flash-lite

# Target Web Project Configuration (Optional dynamic default)
TARGET_PROJECT_PATH=
TARGET_BASE_URL=

# Screen Demo AI Studio Web Dashboard Port
DASHBOARD_PORT=3333
