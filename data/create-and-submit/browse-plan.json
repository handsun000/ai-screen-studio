{
  "url": "https://gwdev.unison.co.kr/",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "requiresLogin": true,
  "cursor": {
    "delayMs": 800,
    "preClickRestMs": 180
  },
  "actions": [
    {
      "type": "wait",
      "description": "메인 대시보드 로딩 및 시각적 앵커 대기 (Phase 1)",
      "ms": 3500
    },
    {
      "type": "click",
      "description": "상단 GNB '전체메뉴' 버튼 클릭",
      "selector": "button.btn_svc_open:visible, .btn_svc_open:visible"
    },
    {
      "type": "wait",
      "description": "전체메뉴 레이어 펼침 대기",
      "ms": 1500
    },
    {
      "type": "click",
      "description": "전체메뉴 내 '일정관리' 메뉴 클릭 (Phase 2)",
      "selector": "#svc_box a:has-text(\"일정관리\"), #svc_box a:has-text(\"일정\")"
    },
    {
      "type": "wait",
      "description": "일정관리 화면 로딩 및 대시보드 렌더링 대기",
      "ms": 3500
    },
    {
      "type": "click",
      "description": "상단 [일정 등록] 버튼 클릭 (Phase 3)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible"
    },
    {
      "type": "wait",
      "description": "일정 등록 모달창 로딩 대기",
      "ms": 2000
    },
    {
      "type": "type",
      "description": "일정 제목에 '주간 부서 회의' 입력",
      "selector": "#subject:visible, input#subject, input[name*=\"subject\"]:visible",
      "text": "주간 부서 회의"
    },
    {
      "type": "wait",
      "description": "제목 입력 확인 대기",
      "ms": 1000
    },
    {
      "type": "click",
      "description": "조직도 선택 팝업 열기 버튼 클릭",
      "selector": "#btn_orgUIselectDialog, button:has-text(\"조직도\"), button:has(.ico_org)",
      "optional": true
    },
    {
      "type": "wait",
      "description": "조직도 팝업 로딩 대기",
      "ms": 2000,
      "optional": true
    },
    {
      "type": "click",
      "description": "조직도 팝업 '확인' 또는 '적용' 버튼 클릭",
      "selector": "button#link_res_confirm, .ui-dialog:visible button#link_res_confirm, .ui-dialog:visible button:has-text('확인'), button:has-text('확인'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "조직도 반영 대기",
      "ms": 1500,
      "optional": true
    },
    {
      "type": "type",
      "description": "일정 내용 필드에 '이번 주 주요 업무 진행 상황 공유 및 이슈 논의' 입력",
      "selector": "#cn:visible, textarea:visible, textarea[placeholder*=\"내용\"]",
      "text": "이번 주 주요 업무 진행 상황 공유 및 이슈 논의"
    },
    {
      "type": "wait",
      "description": "내용 입력 확인 대기",
      "ms": 1000
    },
    {
      "type": "click",
      "description": "일정 등록 모달 [저장] 버튼 클릭 (Phase 4)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible"
    },
    {
      "type": "wait",
      "description": "저장 처리 및 팝업 닫힘 대기",
      "ms": 2000
    },
    {
      "type": "click",
      "description": "저장 완료 알림 확인 버튼 클릭 (표시 시)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "캘린더 및 일정 목록 반영 대기",
      "ms": 3000
    },
    {
      "type": "click",
      "description": "등록된 일정 상세 확인을 위해 캘린더 내 생성된 일정 항목 클릭 (Phase 5)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "일정 상세 화면 와이드 뷰 확인 및 아웃트로 마무리",
      "ms": 3500
    }
  ]
}