{
  "url": "https://gwdev.unison.co.kr/",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "requiresLogin": true,
  "cursor": {
    "delayMs": 800,
    "preClickRestMs": 180
  },
  "actions": [
    {
      "type": "wait",
      "description": "메인 대시보드 로딩 및 시각적 앵커 대기 (Phase 1)",
      "ms": 3500
    },
    {
      "type": "click",
      "description": "상단 GNB '전체메뉴' 버튼 클릭",
      "selector": "button.btn_svc_open:visible, .btn_svc_open:visible"
    },
    {
      "type": "wait",
      "description": "전체메뉴 레이어 펼침 대기",
      "ms": 1500
    },
    {
      "type": "click",
      "description": "전체메뉴 내 '일정관리' 메뉴 클릭 (Phase 2)",
      "selector": "#svc_box a:has-text(\"일정관리\"), #svc_box a:has-text(\"일정\")"
    },
    {
      "type": "wait",
      "description": "일정관리 화면 로딩 및 대시보드 렌더링 대기",
      "ms": 3500
    },
    {
      "type": "click",
      "description": "상단 [일정 등록] 버튼 클릭 (Phase 3)",
      "selector": "button#reg_shedule_lefttop, #reg_shedule_lefttop, button:has-text('일정 등록'):visible, button:has-text('일정등록'):visible"
    },
    {
      "type": "wait",
      "description": "일정 등록 모달창 로딩 대기",
      "ms": 2000
    },
    {
      "type": "type",
      "description": "일정 제목에 '프로젝트 주간회의' 입력",
      "selector": "#subject:visible, input#subject, input[name*=\"subject\"]:visible",
      "text": "프로젝트 주간회의"
    },
    {
      "type": "wait",
      "description": "제목 입력 확인 대기",
      "ms": 1000
    },
    {
      "type": "click",
      "description": "자원예약 사용 체크박스 선택",
      "selector": "label:has-text('예약사용'), text='예약사용', label:has-text('예약 사용'), label[for='scd_link_res_chk'], #reg_schedule_form #scd_link_res_chk, input#scd_link_res_chk",
      "optional": true,
      "force": true
    },
    {
      "type": "wait",
      "description": "자원예약 연동 영역 활성화 대기",
      "ms": 1200,
      "optional": true
    },
    {
      "type": "click",
      "description": "자원예약 모달창 호출 버튼 클릭",
      "selector": "button#scd_link_res_select_button, #scd_link_res_select button, button:has(.ico_plus), button:has-text('자원예약'), button:has-text('예약 선택'), button[title*='추가']",
      "optional": true
    },
    {
      "type": "wait",
      "description": "자원예약 모달창 로딩 대기",
      "ms": 2000,
      "optional": true
    },
    {
      "type": "click",
      "description": "자원예약 팝업 내 '시설' 탭 클릭",
      "selector": ".ui-dialog:visible a:has-text('시설'), .ui-dialog:visible a:has-text('회의실'), #resSelect_resSelect a:has-text('시설'), a:has-text('시설'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "시설 목록 로딩 대기",
      "ms": 1500,
      "optional": true
    },
    {
      "type": "click",
      "description": "시설 목록 중 첫 번째 항목 선택",
      "selector": ":text('3층 회의실'), div:has-text('3층 회의실'):visible, li:has-text('3층 회의실'), .ui-dialog:visible div[class*='lst'] > *:first-child, .ui-dialog:visible ul > li:first-child, .ui-dialog:visible table tr:first-child",
      "optional": true
    },
    {
      "type": "click",
      "description": "자원예약 팝업 [확인] 버튼 클릭",
      "selector": "button#link_res_confirm, .ui-dialog:visible button#link_res_confirm, .ui-dialog:visible button:has-text('확인'), button:has-text('확인'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "자원예약 선택 반영 대기",
      "ms": 1500,
      "optional": true
    },
    {
      "type": "type",
      "description": "일정 내용 필드에 '금주 주요 개발 일정 및 이슈 공유 회의입니다.' 입력",
      "selector": "#cn:visible, textarea:visible, textarea[placeholder*=\"내용\"]",
      "text": "금주 주요 개발 일정 및 이슈 공유 회의입니다."
    },
    {
      "type": "wait",
      "description": "내용 입력 확인 대기",
      "ms": 1000
    },
    {
      "type": "click",
      "description": "일정 등록 모달 [저장] 버튼 클릭 (Phase 4)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible"
    },
    {
      "type": "wait",
      "description": "저장 처리 및 팝업 닫힘 대기",
      "ms": 2000
    },
    {
      "type": "click",
      "description": "저장 완료 알림 확인 버튼 클릭 (표시 시)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "캘린더 및 일정 목록 반영 대기",
      "ms": 3000
    },
    {
      "type": "click",
      "description": "등록된 일정 상세 확인을 위해 캘린더 내 생성된 일정 항목 클릭 (Phase 5)",
      "selector": "button#reg_shedule_lefttop, #reg_shedule_lefttop, button:has-text('일정 등록'):visible, button:has-text('일정등록'):visible",
      "optional": true
    },
    {
      "type": "wait",
      "description": "일정 상세 화면 와이드 뷰 확인 및 아웃트로 마무리",
      "ms": 3500
    }
  ]
}