{
  "url": "https://gwdev.bc.ac.kr",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "requiresLogin": true,
  "cursor": {
    "delayMs": 800,
    "preClickRestMs": 180
  },
  "actions": [
    {
      "type": "wait",
      "description": "메인 포털 대시보드 진입 및 시각적 앵커 대기 (Phase 1)",
      "ms": 2500
    },
    {
      "type": "click",
      "selector": "button.btn_svc_open",
      "description": "전체 메뉴",
      "optional": false,
      "force": false
    },
    {
      "type": "click",
      "description": "상단 GNB '일정관리' 메뉴 클릭 (Phase 2)",
      "selector": "a:has-text(\"일정관리\"):visible, #svc_lst a:has-text(\"일정\"), #svc_box a:has-text(\"일정관리\")"
    },
    {
      "type": "wait",
      "description": "일정관리 메인 화면 및 캘린더 로딩 대기",
      "ms": 2000
    },
    {
      "type": "click",
      "description": "좌측 사이드바 상단 [일정 등록] 버튼 클릭 (Phase 3)",
      "selector": "button#reg_shedule_lefttop, #reg_shedule_lefttop, button:has-text('일정 등록'):visible, button:has-text('일정등록'):visible"
    },
    {
      "type": "wait",
      "description": "일정 등록 모달 다이얼로그 로딩 대기",
      "ms": 1500
    },
    {
      "type": "type",
      "description": "일정 제목 필드에 '프로젝트 주간회의' 입력",
      "selector": "#reg_schedule_form #subject, .ui-dialog:visible #subject, input#subject:visible",
      "text": "프로젝트 주간회의"
    },
    {
      "type": "wait",
      "description": "제목 입력 확인 대기",
      "ms": 800
    },
    {
      "type": "click",
      "description": "기간 시작일 기본 설정 확인",
      "selector": "#reg_schedule_form #startDate1, .ui-dialog:visible #startDate1, input#startDate1:visible",
      "optional": false
    },
    {
      "type": "wait",
      "description": "기간 필드 확인 대기",
      "ms": 800,
      "optional": false
    },
    {
      "type": "click",
      "description": "자원예약 [예약사용] 체크박스 선택",
      "selector": "label:has-text('예약사용'), text='예약사용', label:has-text('예약 사용'), label[for='scd_link_res_chk'], #reg_schedule_form #scd_link_res_chk, input#scd_link_res_chk",
      "force": true
    },
    {
      "type": "wait",
      "description": "자원예약 선택 영역 활성화 대기",
      "ms": 1200
    },
    {
      "type": "click",
      "description": "자원 선택 [추가] 버튼 클릭",
      "selector": "button#scd_link_res_select_button, #scd_link_res_select button, button:has(.ico_plus), button:has-text('자원예약'), button:has-text('예약 선택'), button[title*='추가']",
      "optional": false
    },
    {
      "type": "wait",
      "description": "자원예약 선택 모달 레이어 로딩 대기",
      "ms": 1800
    },
    {
      "type": "click",
      "description": "자원예약 모달 내 '시설' 탭 클릭",
      "selector": ".ui-dialog:visible a:has-text('시설'), .ui-dialog:visible a:has-text('회의실'), #resSelect_resSelect a:has-text('시설'), a:has-text('시설'):visible",
      "optional": false
    },
    {
      "type": "wait",
      "description": "시설 자원 목록 로딩 대기",
      "ms": 1200,
      "optional": false
    },
    {
      "type": "click",
      "description": "시설 목록 중 첫 번째 자원 항목 선택",
      "selector": ":text('3층 회의실'), div:has-text('3층 회의실'):visible, li:has-text('3층 회의실'), .ui-dialog:visible div[class*='lst'] > *:first-child, .ui-dialog:visible ul > li:first-child, .ui-dialog:visible table tr:first-child",
      "optional": false
    },
    {
      "type": "click",
      "description": "자원예약 모달 [확인] 버튼 클릭",
      "selector": "button#resSelect_confirm, button:has-text('확인'), button:has-text('확인'):visible",
      "optional": false
    },
    {
      "type": "wait",
      "description": "자원예약 반영 및 일정 상세 모달 복귀 대기",
      "ms": 1500
    },
    {
      "type": "type",
      "description": "일정 내용 필드에 '금주 주요 개발 일정 및 이슈 공유 회의입니다.' 입력",
      "selector": "#reg_schedule_form #cn, .ui-dialog:visible #cn, textarea#cn:visible, textarea[placeholder*='내용']:visible",
      "text": "금주 주요 개발 일정 및 이슈 공유 회의입니다."
    },
    {
      "type": "wait",
      "description": "내용 입력 확인 대기",
      "ms": 800
    },
    {
      "type": "click",
      "description": "일정 등록 모달 최종 [저장] 버튼 클릭 (Phase 4)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible"
    },
    {
      "type": "wait",
      "description": "저장 처리 및 데이터 반영 대기",
      "ms": 1800
    },
    {
      "type": "click",
      "description": "등록 완료 안내 팝업 [확인] 클릭 (표시 시)",
      "selector": "#reg_schedule_form #savebtn, .ui-dialog:visible #savebtn, button#savebtn:visible, button:has-text('저장'):visible, button:has-text('등록'):visible",
      "optional": false
    },
    {
      "type": "wait",
      "description": "캘린더 메인 화면 갱신 대기",
      "ms": 1800
    },
    {
      "type": "click",
      "description": "캘린더 내 등록된 '프로젝트 주간회의' 일정 확인 클릭 (Phase 5)",
      "selector": "button#reg_shedule_lefttop, #reg_shedule_lefttop, button:has-text('일정 등록'):visible, button:has-text('일정등록'):visible",
      "optional": false
    },
    {
      "type": "wait",
      "description": "등록된 일정 결과 확인 및 영상 마무리 아웃트로 대기",
      "ms": 2500
    }
  ]
}